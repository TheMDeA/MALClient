<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="120dp"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_marginEnd="12dp">
  <FFImageLoading.Views.ImageViewAsync
      android:id="@+id/HomeRailItemImage"
      android:layout_width="120dp"
      android:layout_height="170dp"
      android:scaleType="centerCrop"
      android:background="@drawable/redesign_card_background" />
  <TextView
      android:id="@+id/HomeRailItemTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="12sp"
      android:textColor="?BrushText"
      android:maxLines="2"
      android:ellipsize="end"
      android:layout_marginTop="6dp" />
  <TextView
      android:id="@+id/HomeRailItemSubtitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textSize="11sp"
      android:textColor="?BrushSettingsSubtitle" />
</LinearLayout>
